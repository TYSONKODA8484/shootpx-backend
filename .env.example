# Copy this file to .env and fill in the real values. .env itself is
# gitignored — this template is what's committed, so anyone setting the
# project up from scratch knows exactly what's needed.

ENV=development
DEBUG=true

# --- URLs ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
TEST_CONSOLE_URL=http://localhost:5500

# --- Database ---
# Local Postgres, database "shootpx".
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/shootpx

# --- Session signing key (our cookie, separate from Firebase) ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# --- Firebase Admin SDK ---
# Firebase Console -> (gear icon) Project Settings -> Service Accounts
#   -> "Generate new private key" -> downloads a JSON file.
# Save it in this backend/ folder as firebase-service-account.json (already
# gitignored) and leave this pointing at it, or change the path.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# --- Local file storage for uploaded/generated assets ---
STORAGE_ROOT_DIR=./storage

# --- Redis (arq task queue + per-team generation lock) ---
# Local Memurai/Docker/WSL Redis all listen here by default — see DESIGN.md
# for how to get one running on Windows.
REDIS_URL=redis://localhost:6379/0

# --- Generation pipeline ---
MAX_CONCURRENT_GENERATIONS=10
MOCK_GENERATION_DELAY_SECONDS=3

# --- Resend SMTP (sends the email sign-in link and team-invite emails) ---
# REQUIRED for magic-link login and team invites to actually deliver mail.
# SMTP_PASSWORD is the re_... API key from Resend -> API Keys -> Create API Key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
EMAIL_FROM_NAME=ShootPX
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
